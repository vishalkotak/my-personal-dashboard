.DS_Store
build/
DerivedData/
xcuserdata/

# Local secrets / machine-specific values
Config/Secrets.xcconfig
scripts/local.env

# The Xcode project is generated by XcodeGen from project.yml…
HealthSync.xcodeproj/*
# …except the dependency lockfile, which must be committed (supply-chain pinning).
!HealthSync.xcodeproj/project.xcworkspace/
HealthSync.xcodeproj/project.xcworkspace/*
!HealthSync.xcodeproj/project.xcworkspace/xcshareddata/
HealthSync.xcodeproj/project.xcworkspace/xcshareddata/*
!HealthSync.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
