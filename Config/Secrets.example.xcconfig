// Copy this file to Config/Secrets.xcconfig and fill in your values. Secrets.xcconfig is gitignored.
// Note: "//" starts a comment in xcconfig files, hence the https:/$()/ trick below.
//
// SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY: Supabase → Project Settings → API.
//   Only ever use the *publishable* (or anon) key here — never the secret / service_role key.
// DEVELOPMENT_TEAM: your Apple Team ID (Xcode → Settings → Accounts, or the Signing tab).
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
DEVELOPMENT_TEAM = REPLACE_ME
