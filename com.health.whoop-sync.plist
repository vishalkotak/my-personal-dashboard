<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.health.whoop-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/vishal/workspace/my-health-app/backend/sync_service.py</string>
        <string>--daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vishal/workspace/my-health-app</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vishal/workspace/my-health-app/logs/sync_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vishal/workspace/my-health-app/logs/sync_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Run when laptop wakes up if missed scheduled time -->
    <key>StartOnMount</key>
    <false/>

    <!-- Keep trying even after failures -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Run immediately if the scheduled time was missed -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
