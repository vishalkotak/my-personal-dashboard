# Copy to dashboard/.env (gitignored) and fill in. Never commit the real file.

# Read-only connection string for the healthsync_reader role (see sql/readonly_role.sql).
# Use Supabase's SESSION POOLER (port 5432). Custom roles log in as <role>.<project-ref>:
DATABASE_URL=postgresql://healthsync_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Your local time zone; days and nights are bucketed in it.
TZ_NAME=America/Los_Angeles

# Optional: only show rows from this account (the ID shown in the iPhone app).
# Leave empty to show every row the reader can see.
HEALTH_USER_ID=

# Set to 1 to ignore DATABASE_URL and serve synthetic demo data instead.
DEMO=0

# Ports (both bind to 127.0.0.1 only).
API_PORT=8000
FRONTEND_PORT=5173

# Optional: where the app's type catalog lives (default: apple-health-sync/HealthSync/HealthTypes.json).
HEALTH_TYPES_PATH=

# Optional, demo mode only: pin "now" (ISO with offset), e.g. for screenshots.
DEMO_NOW=
